---
import { experience } from '../content/facts';
import { en, experienceCopy, roleTitles } from '../content/locales/en';
import type { ExperienceCopy } from '../content/schema';
import DateRange from './DateRange.astro';
---

<ol class="experience-timeline">
  {
    experience.map((entry) => {
      const copy: ExperienceCopy = experienceCopy[entry.id];
      return (
        <li class="experience-entry">
          <article aria-labelledby={`company-${entry.id}`}>
            <h3 id={`company-${entry.id}`} class="text-lg font-semibold text-text">
              {entry.company}
            </h3>
            <p class="mt-1 text-sm">{entry.location}</p>
            <ul class="mt-4 space-y-4">
              {entry.roles.map((role) => (
                <li>
                  <p class="font-medium text-text">{roleTitles[role.id]}</p>
                  <p class="mt-1 text-sm">
                    <DateRange start={role.start} end={role.end} />
                  </p>
                </li>
              ))}
            </ul>
            <p class="mt-4">{copy.summary}</p>
            {copy.details && copy.details.length > 0 && (
              <details name="experience-details" class="experience-details mt-3">
                <summary>
                  <span class="details-show">{en.experienceDetails.show}</span>
                  <span class="details-hide">{en.experienceDetails.hide}</span>
                  <span class="sr-only"> for {entry.company}</span>
                </summary>
                <ul class="list-disc space-y-3 pb-2 pl-5">
                  {copy.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </details>
            )}
          </article>
        </li>
      );
    })
  }
</ol>
