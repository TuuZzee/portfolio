---
import type { CareerDate, Locale } from '../content/schema';
import { formatDate } from '../utils/formatDate';

interface Props {
  start: CareerDate;
  end?: CareerDate;
  locale: Locale;
  separator: string;
}

const { start, end, locale, separator } = Astro.props;
---

<time datetime={start}>{formatDate(start, locale)}</time>
{end && (
  <>
    {' '}
    {separator} <time datetime={end}>{formatDate(end, locale)}</time>
  </>
)}
