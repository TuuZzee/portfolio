---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { locales, type PortfolioContent } from '../content/schema';

import '../styles/global.css';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const { title, description, ogLocale } = content.metadata;
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const alternates = Astro.site
  ? locales.map((locale) => ({ locale, url: new URL(getRelativeLocaleUrl(locale), Astro.site) }))
  : [];
---

<!doctype html>
<html lang={content.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {alternates.map(({ locale, url }) => (
      <link rel="alternate" hreflang={locale} href={url} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${assetBase}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${assetBase}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${assetBase}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${assetBase}apple-touch-icon.png`} />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const stored = localStorage.getItem('portfolio-theme');
          if (stored === 'light' || stored === 'dark') {
            preference = stored;
          }
        } catch {
          // Follow the system preference when storage is blocked.
        }
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme =
          preference === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body id="top" class="min-h-screen bg-surface text-text antialiased">
    <a href="#main-content" class="skip-link">
      {content.ui.skipLink}
    </a>
    <slot />
  </body>
</html>
