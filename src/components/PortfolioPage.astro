---
import DateRange from '../components/DateRange.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ProfilePortrait from '../components/ProfilePortrait.astro';
import SectionContainer from '../components/SectionContainer.astro';
import SelectedWork from '../components/SelectedWork.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getContent } from '../content';
import { education, profile, publicLinks } from '../content/facts';
import type { EducationFact, Locale } from '../content/schema';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const { educationCopy, skillGroups } = content;

const educationEntries: readonly (EducationFact & { title: string })[] = education.map((entry) => ({
  ...entry,
  ...educationCopy[entry.id],
}));
---

<BaseLayout content={content}>
  <SiteHeader content={content} />
  <main id="main-content" tabindex="-1" class="site-container">
    <section class="hero" aria-labelledby="hero-heading">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-widest text-interactive uppercase">
          {content.hero.discipline} · {content.locationLabels[profile.location]}
        </p>
        <h1
          id="hero-heading"
          class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"
        >
          {content.hero.heading}
        </h1>
        <p class="mt-6 max-w-prose text-lg text-muted">{content.hero.introduction}</p>
        <a href="#work" class="primary-link mt-8">
          {content.hero.action}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ProfilePortrait alt={content.ui.portraitAlt} />
    </section>

    <SectionContainer id="about" title={content.sections.about.title}>
      <div class="space-y-5">
        {content.about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </SectionContainer>

    <SectionContainer id="work" title={content.sections.work.title}>
      <SelectedWork content={content} />
    </SectionContainer>

    <SectionContainer id="experience" title={content.sections.experience.title}>
      <ExperienceTimeline content={content} />
    </SectionContainer>

    <SectionContainer id="skills" title={content.sections.skills.title}>
      <ul class="space-y-7">
        {skillGroups.map(({ id, title, items, note }) => (
          <li aria-labelledby={`skills-${id}`}>
            <h3 id={`skills-${id}`} class="font-semibold text-text">
              {title}
            </h3>
            {note && <p class="mt-2 text-sm">{note}</p>}
            <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </SectionContainer>

    <SectionContainer id="education" title={content.sections.education.title}>
      <ul class="space-y-6">
        {educationEntries.map(({ institution, location, title, start, end }) => (
          <li>
            <h3 class="font-semibold text-text">{institution ?? title}</h3>
            {institution && <p class="mt-1">{title}</p>}
            <p class="mt-1 text-sm">
              <DateRange
                start={start}
                end={end}
                locale={locale}
                separator={content.dateSeparator}
              />
            </p>
            {location && <p class="mt-1 text-sm">{content.locationLabels[location]}</p>}
          </li>
        ))}
      </ul>
    </SectionContainer>

    <SectionContainer id="contact" title={content.sections.contact.title}>
      <p>{content.contact}</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href={publicLinks.linkedin} class="text-link">
            {content.links.linkedin}
          </a>
        </li>
        <li>
          <a href={publicLinks.github} class="text-link">
            {content.links.github}
          </a>
        </li>
      </ul>
    </SectionContainer>
  </main>
  <SiteFooter content={content} />
</BaseLayout>
