---
import DateRange from '../components/DateRange.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ProfilePortrait from '../components/ProfilePortrait.astro';
import SectionContainer from '../components/SectionContainer.astro';
import SelectedWork from '../components/SelectedWork.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { education, profile, publicLinks } from '../content/facts';
import { educationCopy, en, skillGroups } from '../content/locales/en';
import type { EducationFact } from '../content/schema';
import BaseLayout from '../layouts/BaseLayout.astro';

const educationEntries: readonly (EducationFact & { title: string })[] = education.map((entry) => ({
  ...entry,
  ...educationCopy[entry.id],
}));
---

<BaseLayout title={en.metadata.title} description={en.metadata.description}>
  <SiteHeader />
  <main id="main-content" tabindex="-1" class="site-container">
    <section class="hero" aria-labelledby="hero-heading">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-widest text-interactive uppercase">
          {en.hero.discipline} · {profile.location}
        </p>
        <h1
          id="hero-heading"
          class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"
        >
          {en.hero.heading}
        </h1>
        <p class="mt-6 max-w-prose text-lg text-muted">{en.hero.introduction}</p>
        <a href="#work" class="primary-link mt-8">
          {en.hero.action}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ProfilePortrait />
    </section>

    <SectionContainer id="about" title={en.sections.about.title}>
      <div class="space-y-5">{en.about.map((paragraph) => <p>{paragraph}</p>)}</div>
    </SectionContainer>

    <SectionContainer id="work" title={en.sections.work.title}>
      <SelectedWork />
    </SectionContainer>

    <SectionContainer id="experience" title={en.sections.experience.title}>
      <ExperienceTimeline />
    </SectionContainer>

    <SectionContainer id="skills" title={en.sections.skills.title}>
      <ul class="space-y-7">
        {
          skillGroups.map(({ id, title, items, note }) => (
            <li aria-labelledby={`skills-${id}`}>
              <h3 id={`skills-${id}`} class="font-semibold text-text">
                {title}
              </h3>
              {note && <p class="mt-2 text-sm">{note}</p>}
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </SectionContainer>

    <SectionContainer id="education" title={en.sections.education.title}>
      <ul class="space-y-6">
        {
          educationEntries.map(({ institution, location, title, start, end }) => (
            <li>
              <h3 class="font-semibold text-text">{institution ?? title}</h3>
              {institution && <p class="mt-1">{title}</p>}
              <p class="mt-1 text-sm">
                <DateRange start={start} end={end} />
              </p>
              {location && <p class="mt-1 text-sm">{location}</p>}
            </li>
          ))
        }
      </ul>
    </SectionContainer>

    <SectionContainer id="contact" title={en.sections.contact.title}>
      <p>{en.contact}</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={publicLinks.linkedin} class="text-link">{en.links.linkedin}</a></li>
        <li><a href={publicLinks.github} class="text-link">{en.links.github}</a></li>
      </ul>
    </SectionContainer>
  </main>
  <SiteFooter />
</BaseLayout>
