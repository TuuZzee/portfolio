---
import { profile } from '../content/facts';
import type { PortfolioContent } from '../content/schema';
import { sectionIds } from '../data/sections';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
---

<header class="site-header">
  <div class="site-container header-content">
    <a href="#top" class="site-name">
      {profile.name}
      <span aria-hidden="true">.</span>
    </a>
    <div class="header-controls">
      <LanguageSwitcher content={content} />
      <ThemeToggle content={content} />
    </div>
    <nav aria-label={content.ui.mainNavigation} class="site-navigation">
      <ul>
        {sectionIds.map((id) => (
          <li>
            <a href={`#${id}`}>{content.sections[id].navigationLabel}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/activeNavigation';

  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('.header-dropdown');

  function dismiss(dropdown: HTMLDetailsElement) {
    const hadFocus = dropdown.contains(document.activeElement);
    dropdown.open = false;
    if (hadFocus) dropdown.querySelector('summary')?.focus();
  }

  function dismissOutside(event: Event) {
    const target = event.target;
    if (!(target instanceof Node)) return;

    for (const dropdown of dropdowns) {
      if (dropdown.open && !dropdown.contains(target)) {
        dismiss(dropdown);
      }
    }
  }

  document.addEventListener('click', dismissOutside);
  document.addEventListener('focusin', dismissOutside);
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented) return;

    for (const dropdown of dropdowns) {
      if (dropdown.open) {
        event.preventDefault();
        dismiss(dropdown);
      }
    }
  });
</script>
