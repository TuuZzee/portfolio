---
import { Image } from 'astro:assets';

import portrait from '../assets/profile-face-400w.png';

interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

<Image
  src={portrait}
  alt={alt}
  widths={[240, 320, 400]}
  sizes="(min-width: 48rem) 320px, (min-width: 24rem) 280px, 240px"
  width={400}
  height={354}
  loading="eager"
  fetchpriority="high"
  class="profile-portrait"
/>
