---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="content-section">
  <h2 id={`${id}-heading`} class="text-2xl font-semibold tracking-tight">{title}</h2>
  <div class="max-w-prose text-muted"><slot /></div>
</section>
